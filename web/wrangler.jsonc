{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kururi-ai",
  "main": "src/edge/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/models/*"]
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "kururi-ai-models"
    }
  ],
  "routes": [
    {
      "pattern": "kururi-ai.2-38.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  }
}
