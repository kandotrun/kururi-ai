{
  "name": "kururi-ai-web-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "ast-grep test --skip-snapshot-tests && ast-grep scan --error",
    "test:unit": "vitest run",
    "build": "node scripts/copy-assets.mjs && tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "pretest": "npm run assets",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "onnxruntime-web": "1.23.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "wrangler": "4.156.0"
  }
}
